  "description": "Kitchen ticket print agent — Star TSP100 LAN (raster) via receiptline",
  "private": true,
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
